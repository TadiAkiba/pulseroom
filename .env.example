PORT=3001
APP_URL=http://localhost:3001
DATABASE_PATH=./data/engagement.sqlite
SESSION_TTL_HOURS=8

# Production guidance:
# - set ENABLE_DEMO_SEED=false
# - set ALLOW_ORGANIZER_SIGNUP=false if you want invite/bootstrap-only access
ENABLE_DEMO_SEED=true
ALLOW_ORGANIZER_SIGNUP=true

# Optional bootstrap organizer for first login
BOOTSTRAP_ORGANIZER_EMAIL=
BOOTSTRAP_ORGANIZER_PASSWORD=

# Current analysis provider
ANALYSIS_PROVIDER=heuristic
