PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/engagement.sqlite
SESSION_TTL_HOURS=8

# Production guidance:
# - set ENABLE_DEMO_SEED=false
# - set ALLOW_ORGANIZER_SIGNUP=false if you want a fixed organizer list.
#   Even when signup is disabled, the FIRST organizer can always be created
#   from the dashboard UI when the database is empty.
ENABLE_DEMO_SEED=true
ALLOW_ORGANIZER_SIGNUP=true

# Current analysis provider
ANALYSIS_PROVIDER=heuristic

# Optional frontend override when the UI is hosted separately, such as Vercel
VITE_API_URL=
VITE_SOCKET_URL=

# Comma-separated extra origins allowed to call the backend with credentials
CORS_ALLOWED_ORIGINS=

# Convex public live sync
# Enable after your Convex functions are deployed. All three CONVEX_URL,
# CONVEX_HTTP_ACTIONS_URL, and CONVEX_SYNC_SECRET are required for sync to run.
# The VITE_* versions are build-time fallbacks — at runtime the server reports
# the actual settings to the browser, so you can toggle sync without a rebuild.
ENABLE_CONVEX_PUBLIC_SYNC=false
CONVEX_URL=https://charming-shrimp-707.convex.cloud
VITE_CONVEX_URL=https://charming-shrimp-707.convex.cloud
CONVEX_HTTP_ACTIONS_URL=https://charming-shrimp-707.convex.site
VITE_ENABLE_CONVEX_PUBLIC_SYNC=false

# Required shared secret for Express -> Convex snapshot sync (set on both sides)
CONVEX_SYNC_SECRET=
